# Konfiguration des Dometic Bordelektrik-Beraters.

# true  -> In-Memory-Demo-Daten (MockDataService), keine Dataverse-Verbindung
# false -> Dataverse Web API (DataverseService)
VITE_DEMO_MODE=false

# Basis-URL der Dataverse-Umgebung (nur ohne Demo-Modus noetig),
# z. B. https://contoso.crm4.dynamics.com
VITE_DATAVERSE_URL=

# Optionaler Bearer-Token fuer die Dataverse Web API (sonst Host-Session).
VITE_DATAVERSE_TOKEN=

# Azure-Function-Proxy fuer den KI-Chat (Standard bereits im Code hinterlegt).
VITE_CHAT_API_URL=https://dometic-berater.azurewebsites.net/api/dometic-chat
